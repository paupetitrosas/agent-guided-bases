(* ::Package:: *)

(* ::Title:: *)
(*SkillCore`Records`: the files of a sector (masters.m, basis.m, attempts.m, notes.md), the run folder, and the JSON*)
(*verdict with the exit code every script ends with (shared by both skills); the ledger of tools and papers is in*)
(*Citations.wl*)


BeginPackage["SkillCore`Records`", {"SkillCore`"}];

MCBWriteMasters::usage = "MCBWriteMasters[dir, list] writes masters.m: ONLY the list of basis integrals (exact definitions with square roots, prefactors, eps^k).";
MCBReadMasters::usage = "MCBReadMasters[dir] reads masters.m.";
MCBWriteBasis::usage = "MCBWriteBasis[dir, record] writes basis.m, after $CoreBasisMerge.";
$CoreBasisMerge::usage = "$CoreBasisMerge[dir, record] is what MCBWriteBasis writes: the record, with what a skill keeps from the basis.m it replaces. The default keeps nothing; maximal-cut-basis keeps the Picard-Fuchs classification (MCBKeepClassification).";
MCBReadBasis::usage = "MCBReadBasis[dir] reads basis.m (or <|\"status\" -> \"not run\"|>).";
MCBAppendAttempt::usage = "MCBAppendAttempt[dir, <|\"rung\" -> n, \"what\" -> text, \"outcome\" -> text, \"time\" -> seconds|>] appends to attempts.m (one expression per line). A choice between equally good bases is recorded with \"rung\" -> \"tie-breaker\" and a \"reason\".";
MCBReadAttempts::usage = "MCBReadAttempts[dir] reads attempts.m.";
MCBWriteNotes::usage = "MCBWriteNotes[dir, text] writes notes.md: the agent's reasoning shown in basis.html (\"How this basis was found\").";
MCBAppendNotes::usage = "MCBAppendNotes[dir, text] appends a paragraph to notes.md.";
MCBRecordLiterature::usage = "MCBRecordLiterature[dir, <|\"reference\" -> \"authors, title, journal, arXiv:xxxx.xxxxx or DOI\", \"used\" -> \"what was taken from it and where it went\", \"rung\" -> n, \"outcome\" -> text, \"sector\" -> name, ...|>] records that a paper was used, so that its authors can be acknowledged: CoreRecordPaper (the same keys, checks and messages), then CoreWriteCitations. dir is a sector folder (the sector is then its name) or a run folder. Returns the path of CITATIONS.md, or $Failed.";
MCBReadLiterature::usage = "MCBReadLiterature[runDir] lists the papers of the run: the paper entries of CoreReadCitations (citations.m and an older run's literature.m), oldest first, each with \"reference\", \"used\", \"sector\", \"result\", \"part\" and the optional keys.";
MCBWriteLiterature::usage = "MCBWriteLiterature[runDir] is CoreWriteCitations[runDir]: it writes CITATIONS.md.";
MCBSectorFolderQ::usage = "MCBSectorFolderQ[dir] is True when the name of dir is a sector name j0101...";
CoreRunFolder::usage = "CoreRunFolder[dir] is the run folder of dir: the nearest folder up from dir that holds run_info.m (maximal-cut-basis) or state.m (pole-free-basis); else the parent of a sector folder.";
CoreVerdict::usage = "CoreVerdict[tool, outcome, data] ends a script: it prints one line of JSON, {\"tool\", \"outcome\", \"exit\", ...data}, as the last line of standard output and exits with the code of the outcome (core/README.md): \"pass\" 0, \"fail\" 1, \"usage\" 2, \"error\" 3, \"rerun\" 4. Values that are not JSON (expressions) are written as strings in InputForm.";
CoreJSON::usage = "CoreJSON[expr] is expr made JSON-safe: Associations with string keys, lists, strings, integers, reals, True/False/Null; anything else as its InputForm string.";
$CoreExitCodes::usage = "$CoreExitCodes is the map outcome -> exit code: pass 0, fail 1, usage 2, error 3, rerun 4 (bin/ws adds 75 for no licence slot, 124 for a timeout and 137 for its memory limit).";

Begin["`Private`"];


(* ::Section:: *)
(*Files*)


MCBWriteMasters[dir_String, list_List] := (Put[list, FileNameJoin[{dir, "masters.m"}]]; FileNameJoin[{dir, "masters.m"}]);
MCBReadMasters[dir_String] := With[{f = FileNameJoin[{dir, "masters.m"}]}, If[FileExistsQ[f], Get[f], Missing["NoMasters"]]];

(* a skill sets $CoreBasisMerge to keep what a record written without it would lose, whoever writes the record (an
   AnalysisMasters.m generated by an older toolkit, say) *)
$CoreBasisMerge = (#2 &);
MCBWriteBasis[dir_String, rec_Association] := (Put[$CoreBasisMerge[dir, rec], FileNameJoin[{dir, "basis.m"}]]; FileNameJoin[{dir, "basis.m"}]);
MCBReadBasis[dir_String] := With[{f = FileNameJoin[{dir, "basis.m"}]},
  If[FileExistsQ[f], Replace[Quiet@Get[f], Except[_Association] -> <|"status" -> "not run"|>], <|"status" -> "not run"|>]];

MCBAppendAttempt[dir_String, a_Association] := Module[{f = FileNameJoin[{dir, "attempts.m"}]},
  If[! DirectoryQ[dir], CreateDirectory[dir, CreateIntermediateDirectories -> True]];
  PutAppend[Join[<|"date" -> DateString[{"Year", "-", "Month", "-", "Day", " ", "Hour", ":", "Minute"}]|>, a], f]; f];
MCBReadAttempts[dir_String] := With[{f = FileNameJoin[{dir, "attempts.m"}]}, If[FileExistsQ[f], Select[Quiet@ReadList[f], AssociationQ], {}]];

MCBWriteNotes[dir_String, text_String] := (Export[FileNameJoin[{dir, "notes.md"}], text, "Text"]; FileNameJoin[{dir, "notes.md"}]);
MCBAppendNotes[dir_String, text_String] := Module[{f = FileNameJoin[{dir, "notes.md"}], old},
  old = If[FileExistsQ[f], Import[f, "Text"], ""];
  Export[f, If[old === "", text, old <> "\n\n" <> text], "Text"]; f];


(* ::Section:: *)
(*Sector and run folders*)


MCBSectorFolderQ[dir_String] := StringMatchQ[FileNameTake[dir], RegularExpression["j[01]+"]];

(* the run folder: the nearest folder up from dir that holds run_info.m (maximal-cut-basis) or state.m
   (pole-free-basis, whose sector folders are <run>/<fam>/<jPATTERN>); else the parent of a sector folder. A dir given
   as "." is expanded first, so that a sector folder is known by its name *)
CoreRunFolder[dir0_String] := Module[{d0 = ExpandFileName[dir0], d},
  d = d0;
  While[d =!= "/" && d =!= "" && ! AnyTrue[{"run_info.m", "state.m"}, FileExistsQ[FileNameJoin[{d, #}]] &], d = FileNameDrop[d, -1]];
  If[d === "/" || d === "", If[MCBSectorFolderQ[d0], FileNameDrop[d0, -1], d0], d]];

(* MCBRecordLiterature, MCBReadLiterature and MCBWriteLiterature are defined with the ledger, in Citations.wl *)


(* ::Section:: *)
(*Verdicts*)


(* one interface for the harness: the last line of every script is a JSON object, and the exit code says the outcome *)
$CoreExitCodes = <|"pass" -> 0, "fail" -> 1, "usage" -> 2, "error" -> 3, "rerun" -> 4|>;

CoreJSON[a_Association] := Association[KeyValueMap[ToString[#1] -> CoreJSON[#2] &, a]];
CoreJSON[l_List] := CoreJSON /@ l;
CoreJSON[x : (_String | _Integer | True | False | Null)] := x;
CoreJSON[x_Real] := If[NumericQ[x] && Abs[x] < 10^300, x, ToString[x, InputForm]];
CoreJSON[_Missing] := Null;
CoreJSON[x_] := ToString[x, InputForm];

CoreVerdict[tool_String, outcome_String, data_Association : <||>] := Module[{code = Lookup[$CoreExitCodes, outcome, 3]},
  Print[ExportString[CoreJSON[Join[<|"tool" -> tool, "outcome" -> outcome, "exit" -> code|>, data]], "RawJSON", "Compact" -> True]];
  Exit[code]];


End[];
EndPackage[];
