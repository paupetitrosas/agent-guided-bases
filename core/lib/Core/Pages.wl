(* ::Package:: *)

(* ::Title:: *)
(*SkillCore`Pages`: the HTML pages of both skills (one template and one stylesheet), badges and notes; the blocks of*)
(*tools and papers are in Citations.wl*)


BeginPackage["SkillCore`Pages`", {"SkillCore`", "SkillCore`Records`"}];

MCBHTMLEscape::usage = "MCBHTMLEscape[s] escapes &, <, >.";
CoreBadge::usage = "CoreBadge[status] is the HTML badge of a status of either skill.";
CoreMarkdown::usage = "CoreMarkdown[md] turns the agent's notes (paragraphs, # headings, `code`) into HTML.";
CorePage::usage = "CorePage[file, title, body, generator] writes an HTML page with the core template and stylesheet; generator names the skill and version for the footer. Returns file.";
CoreLiteratureList::usage = "CoreLiteratureList[entries] is the HTML list of paper entries (reference, what was used, outcome), as CoreSectorCitationsHTML shows them; \"\" for none. Kept for older pages: a sector page shows CoreSectorCitationsHTML.";
CoreLiteratureSummary::usage = "CoreLiteratureSummary[runDir] writes CITATIONS.md (CoreWriteCitations) and is CoreCitationsHTML[runDir]. Kept for older pages.";

Begin["`Private`"];


MCBHTMLEscape[s_String] := StringReplace[s, {"&" -> "&amp;", "<" -> "&lt;", ">" -> "&gt;"}];
MCBHTMLEscape[x_] := MCBHTMLEscape[ToString[x, InputForm]];
esc = MCBHTMLEscape;

CoreBadge[st_String] := "<span class='badge " <> Which[
    st === "eps-form" || st === "agree", "eps-form",
    st === "pole-free" || st === "accepted", "pole-free",
    st === "eps-polynomial", "eps-polynomial",
    StringContainsQ[st, "maximal cut"], "maxcut",
    st === "inherited" || st === "pending", "inherited",
    st === "open", "open",
    st === "flagged" || st === "rejected", "flagged",
    StringContainsQ[st, "incomplete"] || st === "stale", "incomplete",
    StringContainsQ[st, "skipped"] || st === "not applicable", "skipped",
    MemberQ[{"not run", "not compared", "not in slice"}, st], "not-run",
    True, "failed"] <> "'>" <> esc[st] <> "</span>";
CoreBadge[x_] := CoreBadge[ToString[x]];

CoreMarkdown[md_String] := StringJoin[Table[
    If[StringStartsQ[StringTrim[p], "#"], "<h3>" <> esc[StringTrim[StringReplace[StringTrim[p], StartOfString ~~ "#" .. -> ""]]] <> "</h3>",
      "<p>" <> StringReplace[esc[StringTrim[p]], {RegularExpression["`([^`]+)`"] -> "<code>$1</code>", "\n" -> "<br>"}] <> "</p>"],
    {p, StringSplit[md, RegularExpression["\\n\\s*\\n"]]}]];

CorePage[file_String, title_String, body_String, generator_String] := (
  Export[file, StringReplace[Import[FileNameJoin[{SkillCore`$CoreRoot, "templates", "page.html.tmpl"}], "Text"], {
     "{{TITLE}}" -> esc[title], "{{STYLE}}" -> Import[FileNameJoin[{SkillCore`$CoreRoot, "templates", "style.css"}], "Text"],
     "{{BODY}}" -> body, "{{GENERATED}}" -> "generated by " <> generator <> " on " <> DateString[]}], "Text"];
  file);

(* CoreLiteratureList and CoreLiteratureSummary are defined with the ledger, in Citations.wl *)


End[];
EndPackage[];
