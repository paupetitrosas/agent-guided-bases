#!/bin/sh
# limit: run a command under a time limit and a memory limit, both of which can be changed while it runs.
#
# usage: limit [--timeout S] [--memory GB] [--] command [args ...]
#        limit --list
#        limit --set PID [--timeout S] [--memory GB]
#        limit --stop PID
#
# The time limit is on the command's wall-clock time; the memory limit on the resident memory of the command and of
# every process below it (Wolfram subkernels, Kira, Fermat), added up. Both are checked every 2 s. A job that goes
# over either is stopped with every process below it (TERM, then KILL after 5 s), and limit exits with 124 (time) or
# 137 (memory), after a line on standard error that says which limit and how to raise it. Otherwise it exits with
# the command's own code.
#
# Defaults, when an option is not given:
#   --timeout   $MCB_TIME_LIMIT (seconds), else 86400 (24 h)
#   --memory    $MCB_MEMORY_LIMIT (GB), else an equal share of 90% of this machine's memory for each licence slot
#               (the kernel limit of bin/ws: $MCB_MAX_KERNELS, else the value bin/preflight.wls cached, else 2),
#               four shares at most: a licence with more slots, or without a limit, does not make the share smaller
#   0 means no limit, for either.
#
# Jobs are registered in ~/.cache/maximal-cut-basis/jobs, with those of bin/ws (which starts every kernel through
# limit):
#   --list           the jobs running on this machine (every session), with their time, memory and limits
#   --set PID ...    changes the limits of a running job, PID as --list shows it: give a job that is about to run out
#                    more time or memory, or less. It takes effect at the next check.
#   --stop PID       stops a job with every process below it. Stop only your own jobs.
#   --headroom       the memory (KB) the job this runs in may still use: its memory limit minus what its processes
#                    hold now ("none" when it has no memory limit); outside a job, 90% of the memory available.
#                    Kernels use it to give Kira a memory limit that fits inside their own.
# The command finds its registry file in $MCB_LIMIT_JOB: line 2 holds "limits <seconds> <KB> <start>" (0 = none).

cache="${XDG_CACHE_HOME:-$HOME/.cache}/maximal-cut-basis"
jobs="$cache/jobs"

# machine memory in KB, and the default share of one licence slot
memtotal() {
  if [ -r /proc/meminfo ]; then awk '/^MemTotal:/ {print $2}' /proc/meminfo
  else echo $(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 )); fi
}
kernel_limit() {
  k=${MCB_MAX_KERNELS:-}
  [ -z "$k" ] && [ -f "$cache/max_kernels" ] && k=$(cat "$cache/max_kernels")
  echo "${k:-2}"
}
# seconds as a whole number (the shell compares integers), GB (a decimal number) to KB, and back for messages
secs() { awk -v t="$1" 'BEGIN { printf "%d", t }'; }
gb2kb() { awk -v g="$1" 'BEGIN { printf "%d", g * 1048576 }'; }
kb2gb() { awk -v k="$1" 'BEGIN { printf "%.1f", k / 1048576 }'; }
# number NAME VALUE UNIT: a limit is a plain number. "2h" would be read as 2 s, and a word as 0, which means no limit
number() {
  case "$2" in
    ''|.|*[!0-9.]*|*.*.*) echo "limit: $1 takes a number of $3 (0 = none), not '$2'" >&2; exit 2 ;;
  esac
}
default_kb() {
  if [ -n "${MCB_MEMORY_LIMIT:-}" ]; then gb2kb "$MCB_MEMORY_LIMIT"
  else awk -v t="$(memtotal)" -v k="$(kernel_limit)" 'BEGIN { k = k + 0; if (k < 1) k = 1; if (k > 4) k = 4; printf "%d", 0.9 * t / k }'; fi
}

# descendants PID: the processes below PID, children first
descendants() {
  for c in $(ps -eo pid=,ppid= 2>/dev/null | awk -v p="$1" '$2 == p {print $1}'); do echo "$c"; descendants "$c"; done
}
# treerss PID: resident memory in KB of PID and every process below it
treerss() {
  ps -eo pid=,ppid=,rss= 2>/dev/null | awk -v root="$1" '
    { rss[$1] = $3; kids[$2] = kids[$2] " " $1 }
    END { n = 1; stack[1] = root; total = 0
          for (i = 1; i <= n; i++) { p = stack[i]; total += rss[p]; m = split(kids[p], ks, " "); for (k = 1; k <= m; k++) stack[++n] = ks[k] }
          print total }'
}
# killtree PID: TERM PID and everything below it, then KILL whatever is still alive after 5 s
killtree() {
  kt_all="$1 $(descendants "$1")"
  kill -TERM $kt_all 2>/dev/null
  kt_n=0
  while [ $kt_n -lt 5 ]; do
    kt_alive=""
    for kt_p in $kt_all; do kill -0 "$kt_p" 2>/dev/null && kt_alive="$kt_alive $kt_p"; done
    [ -z "$kt_alive" ] && return 0
    sleep 1; kt_n=$((kt_n + 1))
  done
  kill -KILL $kt_alive 2>/dev/null
}

case "${1:-}" in
  --headroom)
    f=${MCB_LIMIT_JOB:-}
    if [ -n "$f" ] && [ -f "$f" ]; then
      read -r wpid spid t0 rest < "$f"
      set -- $(sed -n '2p' "$f")
      if [ "${3:-0}" = 0 ]; then echo none
      else used=$(treerss "$spid"); echo $(( $3 > used ? $3 - used : 0 )); fi
    elif [ -r /proc/meminfo ]; then awk '/^MemAvailable:/ {printf "%d\n", 0.9 * $2}' /proc/meminfo
    else echo $(( $(memtotal) * 9 / 20 )); fi
    exit 0 ;;
  --list)
    found=0
    for f in "$jobs"/*; do
      [ -f "$f" ] || continue
      read -r wpid spid t0 rest < "$f"
      if kill -0 "$wpid" 2>/dev/null; then
        [ "$found" = 0 ] && echo "PID      running  memory  limits (time, memory)  folder and command" && found=1
        lim=$(sed -n '2p' "$f")
        set -- $lim
        if [ "${1:-}" = "limits" ]; then
          tl=$([ "$2" = 0 ] && echo none || echo "${2}s"); ml=$([ "$3" = 0 ] && echo none || echo "$(kb2gb "$3")GB")
        else tl="-"; ml="-"; fi
        printf '%-8s %6ss  %5sGB  %-22s %s\n' "$wpid" "$(( $(date +%s) - t0 ))" "$(kb2gb "$(treerss "$spid")")" "$tl, $ml" "$rest"
      else rm -f "$f"; fi
    done
    [ "$found" = 0 ] && echo "no jobs started through limit or ws are running"
    exit 0 ;;
  --stop)
    [ -n "${2:-}" ] && [ -f "$jobs/$2" ] || { echo "limit: no job with PID ${2:-?} (limit --list shows them)" >&2; exit 1; }
    kill -TERM "$2" 2>/dev/null
    n=0
    while kill -0 "$2" 2>/dev/null && [ $n -lt 20 ]; do sleep 1; n=$((n + 1)); done
    if kill -0 "$2" 2>/dev/null; then echo "limit: job $2 is still running after 20 s" >&2; exit 1; fi
    echo "limit: job $2 stopped"; exit 0 ;;
  --set)
    [ $# -ge 2 ] || { echo "usage: limit --set PID [--timeout S] [--memory GB]" >&2; exit 2; }
    pid=$2; shift 2
    f="$jobs/$pid"
    [ -n "$pid" ] && [ -f "$f" ] && kill -0 "$pid" 2>/dev/null || { echo "limit: no running job with PID ${pid:-?} (limit --list shows them)" >&2; exit 1; }
    set -- $(sed -n '2p' "$f") "$@"
    [ "${1:-}" = "limits" ] || { echo "limit: job $pid has no limits to change (started by an older bin/ws)" >&2; exit 1; }
    tl=$2; mk=$3; st=$4; shift 4
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout) number --timeout "${2:-}" seconds; tl=$(secs "$2"); shift 2 ;;
        --memory)  number --memory "${2:-}" GB; mk=$(gb2kb "$2"); shift 2 ;;
        *) echo "limit: unknown option $1" >&2; exit 2 ;;
      esac
    done
    tmp="$jobs/.$pid.$$"
    { sed -n '1p' "$f"; echo "limits $tl $mk $st"; } > "$tmp" && mv "$tmp" "$f"
    echo "limit: job $pid now has $([ "$tl" = 0 ] && echo "no time limit" || echo "a time limit of $tl s") and $([ "$mk" = 0 ] && echo "no memory limit" || echo "a memory limit of $(kb2gb "$mk") GB")"
    exit 0 ;;
esac

timeout=${MCB_TIME_LIMIT:-86400}
memkb=""
while [ $# -gt 0 ]; do
  case "$1" in
    --timeout) timeout=${2:-}; shift 2 ;;
    --memory)  number --memory "${2:-}" GB; memkb=$(gb2kb "$2"); shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
number "the time limit (--timeout, MCB_TIME_LIMIT)" "$timeout" seconds
[ -n "$memkb" ] || { [ -z "${MCB_MEMORY_LIMIT:-}" ] || number MCB_MEMORY_LIMIT "$MCB_MEMORY_LIMIT" GB; memkb=$(default_kb); }
timeout=$(secs "$timeout")
[ $# -ge 1 ] || { sed -n '2,30p' "$0"; exit 2; }

# without its registry file the job would run with no limit at all
mkdir -p "$jobs" 2>/dev/null && [ -w "$jobs" ] || { echo "limit: cannot write to $jobs (the limits of a job are kept there); set XDG_CACHE_HOME to a folder you can write to" >&2; exit 2; }
reg="$jobs/$$"
start=$(date +%s)
MCB_LIMIT_JOB=$reg; export MCB_LIMIT_JOB
# the registry exists before the command starts, so that it can read its limits at once
echo "$$ $$ $start $PWD: $*" > "$reg"
echo "limits $timeout $memkb $start" >> "$reg"
"$@" &
pid=$!
# (temporary files are hidden: an older bin/ws lists every other file of the folder)
{ echo "$$ $pid $start $PWD: $*"; echo "limits $timeout $memkb $start"; } > "$jobs/.$$.tmp" && mv "$jobs/.$$.tmp" "$reg"
reason="$jobs/.$$.reason"
rm -f "$reason"

# the watchdog: reads the limits again at every check (limit --set), stops the job at either, and leaves the reason
(
  while kill -0 "$pid" 2>/dev/null; do
    set -- $(sed -n '2p' "$reg" 2>/dev/null)
    tl=${2:-0}; mk=${3:-0}
    now=$(date +%s)
    if [ "$tl" != 0 ] && [ $(( now - start )) -ge "$tl" ]; then
      echo "time $tl" > "$reason"; killtree "$pid"; exit 0
    fi
    if [ "$mk" != 0 ]; then
      used=$(treerss "$pid")
      if [ "${used:-0}" -gt "$mk" ]; then echo "memory $mk $used" > "$reason"; killtree "$pid"; exit 0; fi
    fi
    sleep 2
  done
) &
dog=$!

cleanup() { kill "$dog" 2>/dev/null; rm -f "$reg" "$jobs/.$$.tmp" "$reason"; }
trap 'killtree "$pid"; cleanup; exit 130' INT HUP
trap 'killtree "$pid"; cleanup; exit 143' TERM
wait "$pid" 2>/dev/null   # (the shell would print "Terminated" for a job the watchdog stopped)
rc=$?
# a signal to limit interrupts wait: the trap stops the job; otherwise wait for the watchdog's verdict
if [ -f "$reason" ]; then
  # the watchdog is still stopping what ran below the command (KILL after 5 s for a process that ignores TERM), and
  # cleanup would stop the watchdog first: let it finish
  wait "$dog" 2>/dev/null
  set -- $(cat "$reason")
  case "$1" in
    time)   echo "limit: stopped after $2 s, its time limit (raise it with --timeout or MCB_TIME_LIMIT, or limit --set while it runs)" >&2; rc=124 ;;
    memory) echo "limit: stopped at $(kb2gb "$3") GB, above its memory limit of $(kb2gb "$2") GB (raise it with --memory or MCB_MEMORY_LIMIT, or limit --set while it runs)" >&2; rc=137 ;;
  esac
fi
cleanup
exit $rc
